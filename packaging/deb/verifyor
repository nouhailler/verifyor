#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/verifyor"

if [[ ! -d "$APP_DIR" ]]; then
  echo "Verifyor is not installed in $APP_DIR" >&2
  exit 1
fi

# Option --open : ouvrir le navigateur après démarrage
OPEN_BROWSER=false
for arg in "$@"; do
  [[ "$arg" == "--open" ]] && OPEN_BROWSER=true
done

if $OPEN_BROWSER; then
  (sleep 2 && xdg-open "http://localhost:3000" 2>/dev/null || true) &
fi

cd "$APP_DIR"
exec /usr/bin/node server.js
